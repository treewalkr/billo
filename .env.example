DATABASE_URL=postgres://billo:billo@localhost:5432/billo
BIND_ADDR=0.0.0.0:8080
# Dev only: browser origins allowed to call the API (comma-separated; empty = no CORS).
# 8080 is taken by the server, so `dx serve` falls back to another port; list it here.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Dev only: password-less sign-in via POST /api/v1/auth/dev-login. Never in production.
DEV_LOGIN=true

# Google sign-in (off unless both GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set).
# Create OAuth clients in Google Cloud Console → APIs & Services → Credentials.
# Web client: authorized JS origin http://localhost:8081, redirect URI
# {PUBLIC_URL}/api/v1/auth/google/callback. Never commit the real values.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
# Optional: the iOS client, also accepted by POST /api/v1/auth/google.
GOOGLE_IOS_CLIENT_ID=
# Where this server is reachable from the browser (builds the OAuth redirect URI).
PUBLIC_URL=http://localhost:8080
# App origins the web sign-in may return to (comma-separated, scheme://host[:port]).
APP_REDIRECT_ORIGINS=http://localhost:8081
